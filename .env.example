# PostgreSQL connection string.
# Local development can use a local PostgreSQL database.
# Production must use the Supabase PostgreSQL URL selected for deployment.
# Include SSL parameters if Supabase provides them, for example `?sslmode=require`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/budgetwise?schema=public"

# Auth/session configuration. Generate a strong, unique value for each environment.
# Example command: openssl rand -base64 32
AUTH_SECRET="replace-with-a-generated-secret"

# Base URL used by the application in local development.
# Production must be https://budgetwise.quaye.tech after the Vercel domain is configured.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Reserved for the password-reset email provider selected in Phase 5.
# EMAIL_FROM="BudgetWise <no-reply@example.com>"
