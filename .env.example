# PostgreSQL connection string. Use a local development database only.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/budgetwise?schema=public"

# Auth/session configuration. Generate a strong, unique value for each environment.
AUTH_SECRET="replace-with-a-generated-secret"

# Base URL used by the application in local development.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Reserved for the password-reset email provider selected in Phase 5.
# EMAIL_FROM="BudgetWise <no-reply@example.com>"
